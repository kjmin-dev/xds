{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // The other defaults (two spaces, double quotes, semicolons, trailing commas) are the style
  // the code was written in.
  "printWidth": 100,
  // Keys stay in the order they were written; pnpm and npm append to these files themselves.
  "sortPackageJson": false,
  // One block of imports, without blank lines between groups.
  "sortImports": { "newlinesBetween": false },
  "ignorePatterns": [
    // Markdown tables are aligned by width, and TOML arrays collapse once the `@if` lines in
    // them are gone: both would change in every project `xds create` renames.
    "**/*.md",
    "**/*.toml",
    // Written by tools: the token generator, and JSON.stringify for the files under design/.
    "**/generated",
    "design",
  ],
  // @if template
  // The documentation site's pages; Astro brings the compiler that formats them.
  "astro": true,
  // @endif
  // @if ui-core
  // Tailwind classes are sorted in the order of the stylesheet they come from. It has to bring
  // the tokens' @theme: with Tailwind's own theme, the acme-* utilities are unknown and sort
  // first. A path that does not exist sorts nothing, without an error.
  "overrides": [
    // Every web library and its app take their classes from ui-core's stylesheet. ui-core's
    // recipes are plain strings, which keep the order they were written in: oxfmt sorts class
    // attributes, @apply, and the arguments of the functions an override names.
    {
      "files": [
        "packages/ui-core/**",
        // @if web-react
        "apps/web/**",
        "packages/ui/**",
        // @endif
        // @if web-solid
        "apps/web-solid/**",
        "packages/ui-solid/**",
        // @endif
      ],
      "options": { "sortTailwindcss": { "stylesheet": "./packages/ui-core/src/styles/index.css" } },
    },
    // @if template
    {
      "files": ["apps/docs/**"],
      "options": { "sortTailwindcss": { "stylesheet": "./apps/docs/src/styles/demo.css" } },
    },
    // web-vue and web-svelte each add their app and library to the files of the first override.
    // @endif
  ],
  // @endif
}
