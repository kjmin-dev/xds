{
  "color": {
    "$type": "color",
    "background": {
      "base": {
        "$value": "{palette.neutral.950}",
        "$description": "Page background."
      },
      "surface": {
        "$value": "{palette.neutral.900}",
        "$description": "Cards and panels on top of the page."
      },
      "raised": {
        "$value": "{palette.neutral.850}",
        "$description": "Surfaces that float above the page: menus, dialogs. Lighter than the page in dark mode, where shadows barely show."
      },
      "inverse": {
        "$value": "{palette.neutral.50}",
        "$description": "A surface that stands against the page instead of sitting on it: toasts, tooltips. Dark where the page is light, and light where it is dark."
      },
      "disabled": {
        "$value": "{palette.neutral.800}",
        "$description": "Fill of a disabled control."
      }
    },
    "text": {
      "primary": {
        "$value": "{palette.neutral.50}"
      },
      "secondary": {
        "$value": "{palette.neutral.400}",
        "$description": "Supporting text. Still readable: 4.5:1 on every background."
      },
      "tertiary": {
        "$value": "{palette.neutral.500}",
        "$description": "Placeholders, timestamps and marks such as chevrons. 4.5:1 on the page and on a surface; not for raised surfaces."
      },
      "disabled": {
        "$value": "{palette.neutral.600}",
        "$description": "Text of a disabled control. Exempt from contrast rules, and meant to look unavailable."
      },
      "accent": {
        "$value": "{palette.accent.300}",
        "$description": "Links and accent-colored text on a neutral background."
      },
      "on-accent": {
        "$value": "{palette.neutral.0}",
        "$description": "Text on an accent-colored surface."
      },
      "on-danger": {
        "$value": "{palette.neutral.0}",
        "$description": "Text on a danger-colored surface."
      },
      "on-inverse": {
        "$value": "{palette.neutral.900}",
        "$description": "Text on an inverse surface."
      }
    },
    "border": {
      "default": {
        "$value": "{palette.neutral.800}",
        "$description": "Dividers and card outlines. Decorative, so low contrast is fine."
      },
      "control": {
        "$value": "{palette.neutral.700}",
        "$description": "Outline of a control that its label already identifies, such as a secondary button. Decorative, so it does not have to hold 3:1."
      },
      "strong": {
        "$value": "{palette.neutral.500}",
        "$description": "Outline of a control that would be invisible without it, such as a text field: 3:1 against the background."
      },
      "focus": {
        "$value": "{palette.accent.400}",
        "$description": "Focus ring: 3:1 against the background."
      }
    },
    "accent": {
      "default": {
        "$value": "{palette.accent.500}",
        "$description": "The one action a view is for, and selected states."
      },
      "hover": {
        "$value": "{palette.accent.600}"
      },
      "pressed": {
        "$value": "{palette.accent.700}"
      },
      "subtle": {
        "$value": "{palette.accent.950}",
        "$description": "Tinted background for accent-colored text."
      }
    },
    "control": {
      "default": {
        "$value": "{palette.neutral.800}",
        "$description": "Fill of a neutral control, such as a secondary button."
      },
      "hover": {
        "$value": "{palette.neutral.700}"
      },
      "pressed": {
        "$value": "{palette.neutral.600}"
      }
    },
    "danger": {
      "default": {
        "$value": "{palette.red.600}",
        "$description": "Fill of a destructive action."
      },
      "hover": {
        "$value": "{palette.red.700}"
      },
      "pressed": {
        "$value": "{palette.red.800}"
      }
    },
    "status": {
      "danger": {
        "$value": "{palette.red.400}",
        "$description": "Status colors are for text and icons. Never the only signal: pair them with a word or an icon."
      },
      "danger-subtle": {
        "$value": "{palette.red.950}"
      },
      "success": {
        "$value": "{palette.green.400}"
      },
      "success-subtle": {
        "$value": "{palette.green.950}"
      },
      "warning": {
        "$value": "{palette.amber.400}"
      },
      "warning-subtle": {
        "$value": "{palette.amber.950}"
      },
      "info": {
        "$value": "{palette.blue.400}"
      },
      "info-subtle": {
        "$value": "{palette.blue.950}"
      }
    },
    "overlay": {
      "background": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 0.72,
          "hex": "#000000"
        },
        "$description": "Behind text that is drawn over a picture, such as a badge on an image. Dark enough to carry white text whatever the picture shows, so it is the same in both modes."
      },
      "text": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1,
            1,
            1
          ],
          "hex": "#ffffff"
        },
        "$description": "Text and icons on the overlay background."
      }
    },
    "button": {
      "primary": {
        "background": {
          "$value": "{color.accent.default}"
        },
        "background-hover": {
          "$value": "{color.accent.hover}"
        },
        "background-pressed": {
          "$value": "{color.accent.pressed}"
        },
        "text": {
          "$value": "{color.text.on-accent}"
        }
      },
      "secondary": {
        "background": {
          "$value": "{color.control.default}"
        },
        "background-hover": {
          "$value": "{color.control.hover}"
        },
        "background-pressed": {
          "$value": "{color.control.pressed}"
        },
        "border": {
          "$value": "{color.border.control}"
        },
        "text": {
          "$value": "{color.text.primary}"
        }
      },
      "ghost": {
        "background-hover": {
          "$value": "{color.control.default}",
          "$description": "A ghost button has no fill until it is hovered."
        },
        "background-pressed": {
          "$value": "{color.control.hover}"
        },
        "text": {
          "$value": "{color.text.primary}"
        }
      },
      "danger": {
        "background": {
          "$value": "{color.danger.default}"
        },
        "background-hover": {
          "$value": "{color.danger.hover}"
        },
        "background-pressed": {
          "$value": "{color.danger.pressed}"
        },
        "text": {
          "$value": "{color.text.on-danger}"
        }
      },
      "disabled": {
        "background": {
          "$value": "{color.background.disabled}"
        },
        "text": {
          "$value": "{color.text.disabled}"
        }
      }
    },
    "field": {
      "background": {
        "$value": "{color.background.base}"
      },
      "border": {
        "$value": "{color.border.strong}"
      },
      "border-focus": {
        "$value": "{color.border.focus}"
      },
      "border-invalid": {
        "$value": "{color.status.danger}"
      },
      "text": {
        "$value": "{color.text.primary}"
      },
      "placeholder": {
        "$value": "{color.text.tertiary}",
        "$description": "Placeholder text is text, so it meets 4.5:1, but it is lighter than a value so the two are not confused."
      }
    },
    "badge": {
      "neutral": {
        "background": {
          "$value": "{color.control.default}"
        },
        "text": {
          "$value": "{color.text.secondary}"
        }
      },
      "accent": {
        "background": {
          "$value": "{color.accent.subtle}"
        },
        "text": {
          "$value": "{color.text.accent}"
        }
      },
      "success": {
        "background": {
          "$value": "{color.status.success-subtle}"
        },
        "text": {
          "$value": "{color.status.success}"
        }
      },
      "warning": {
        "background": {
          "$value": "{color.status.warning-subtle}"
        },
        "text": {
          "$value": "{color.status.warning}"
        }
      },
      "danger": {
        "background": {
          "$value": "{color.status.danger-subtle}"
        },
        "text": {
          "$value": "{color.status.danger}"
        }
      }
    },
    "banner": {
      "success": {
        "background": {
          "$value": "{color.status.success-subtle}"
        },
        "accent": {
          "$value": "{color.status.success}"
        }
      },
      "warning": {
        "background": {
          "$value": "{color.status.warning-subtle}"
        },
        "accent": {
          "$value": "{color.status.warning}"
        }
      },
      "danger": {
        "background": {
          "$value": "{color.status.danger-subtle}"
        },
        "accent": {
          "$value": "{color.status.danger}"
        }
      },
      "info": {
        "background": {
          "$value": "{color.status.info-subtle}"
        },
        "accent": {
          "$value": "{color.status.info}"
        }
      },
      "text": {
        "$value": "{color.text.primary}"
      }
    },
    "switch": {
      "track": {
        "$value": "{color.border.strong}",
        "$description": "Off. It holds 3:1 against the page, so the control is visible before it is on."
      },
      "track-on": {
        "$value": "{color.accent.default}"
      },
      "thumb": {
        "$value": "{color.text.on-accent}",
        "$description": "White in both modes: it sits on the accent fill when on."
      },
      "disabled-track": {
        "$value": "{color.background.disabled}"
      },
      "disabled-thumb": {
        "$value": "{color.text.disabled}"
      }
    },
    "checkbox": {
      "border": {
        "$value": "{color.border.strong}"
      },
      "background-checked": {
        "$value": "{color.accent.default}"
      },
      "mark": {
        "$value": "{color.text.on-accent}"
      },
      "disabled-background": {
        "$value": "{color.background.disabled}"
      },
      "disabled-mark": {
        "$value": "{color.text.disabled}"
      }
    },
    "segmented": {
      "track": {
        "$value": "{color.control.default}"
      },
      "text": {
        "$value": "{color.text.secondary}"
      },
      "selected-background": {
        "$value": "{color.background.raised}"
      },
      "selected-border": {
        "$value": "{color.border.control}",
        "$description": "A hairline around the selected segment. Together with a faint shadow and the darker label it sets the segment apart from the track."
      },
      "selected-text": {
        "$value": "{color.text.primary}"
      }
    },
    "avatar": {
      "background": {
        "$value": "{color.accent.subtle}"
      },
      "text": {
        "$value": "{color.text.accent}"
      }
    },
    "progress": {
      "track": {
        "$value": "{color.control.default}"
      },
      "fill": {
        "$value": "{color.text.accent}",
        "$description": "A mark on a neutral track, so it takes the accent text color, which holds 3:1 against the track in both modes."
      }
    },
    "list-row": {
      "background-hover": {
        "$value": "{color.background.raised}"
      },
      "background-pressed": {
        "$value": "{color.control.default}",
        "$description": "Secondary text still has to read on it."
      }
    },
    "top-bar": {
      "background": {
        "$value": "{color.background.base}",
        "$description": "The same as the page: the bar has no edge of its own."
      },
      "text": {
        "$value": "{color.text.primary}"
      },
      "action": {
        "$value": "{color.text.accent}"
      },
      "action-background": {
        "$value": "{color.control.default}",
        "$description": "The round fill behind the back button."
      }
    },
    "tab-bar": {
      "background": {
        "$value": "{color.background.raised}"
      },
      "border": {
        "$value": "{color.border.default}"
      },
      "text": {
        "$value": "{color.text.secondary}"
      },
      "text-selected": {
        "$value": "{color.text.accent}"
      },
      "selected-background": {
        "$value": "{color.accent.subtle}",
        "$description": "The pill behind the selected tab. Its shape marks the selection, so color is not the only signal."
      }
    },
    "sheet": {
      "background": {
        "$value": "{color.background.raised}"
      },
      "handle": {
        "$value": "{color.border.strong}"
      }
    }
  }
}
