---
// Embeds a live example of a touch-only component: a screen of an app, drawn by the React
// Native components through react-native-web, in a frame shaped like a phone.
interface Props {
  name: string;
  title: string;
}
const { name, title } = Astro.props;
---

<!-- The frame is the phone's screen: a sheet that covers the screen covers the frame, not this
     page. Lazy, unlike the web examples: react-native-web is a large module that only these
     three pages need, and it downloads only once the frame is about to come into view. The
     frame takes the mode from this page itself. -->
<div class="demo not-content">
  <div class="phone">
    <iframe title={title} src={`/demo-native/${name}/`} loading="lazy"></iframe>
  </div>
</div>

<style>
  .demo {
    display: flex;
    justify-content: center;
    padding: var(--acme-space-4);
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--acme-radius-lg);
  }
  /* The size of a phone's screen in CSS pixels, with the bezel around it. On a narrow page it
     shrinks to the width there is and keeps its proportions. */
  .phone {
    width: 390px;
    max-width: 100%;
    aspect-ratio: 390 / 640;
    padding: var(--acme-space-2-5);
    border-radius: 54px;
    background: var(--acme-color-border-strong);
  }
  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 44px;
    background: var(--acme-color-background-base);
  }
</style>
