# Astro names each built script and stylesheet after a hash of its contents, so a file under
# these paths never changes: let browsers keep it rather than ask again on every page.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
# Pagefind names its index and fragments the same way; its entry files keep the default.
/pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable
/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
/llms.txt
  Content-Type: text/plain; charset=utf-8
/*.md
  Content-Type: text/markdown; charset=utf-8
