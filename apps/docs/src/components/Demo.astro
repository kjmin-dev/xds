---
// Embeds a live example of a web component, in the mode the reader chose for the site.
interface Props {
  name: string;
  title: string;
}
const { name, title } = Astro.props;
---

<!-- Not lazy: every component page opens with its example, and a lazy frame waits for layout
     before it starts. The frame takes the mode from this page and sets its own height, so
     nothing here has to run first. In a build, scripts/demo-frames.ts writes the example's page
     into the frame, and finds the frame by `data-demo`, which must stay the first attribute. -->
<div class="demo">
  <iframe data-demo={name} title={title} src={`/demo/${name}/`}></iframe>
</div>

<style>
  .demo {
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--acme-radius-lg);
    overflow: hidden;
  }
  iframe {
    display: block;
    width: 100%;
    height: 8rem;
    border: 0;
  }
</style>
