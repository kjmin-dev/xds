{
  "color": {
    "$type": "color",
    "scrim": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0,
          0
        ],
        "alpha": 0.5,
        "hex": "#000000"
      },
      "$description": "Dims the screen behind a sheet. The same in both modes."
    }
  },
  "space": {
    "1": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "2": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "3": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "4": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "5": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "6": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "8": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "10": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    },
    "12": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    },
    "16": {
      "$value": {
        "value": 64,
        "unit": "px"
      }
    },
    "0-5": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "1-5": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "2-5": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "$type": "dimension",
    "$description": "A 4px grid. The name is the multiple of 4; 0-5, 1-5 and 2-5 are the half steps used inside controls."
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 6,
        "unit": "px"
      },
      "$description": "Small parts inside a control: badges, checkboxes."
    },
    "md": {
      "$value": {
        "value": 10,
        "unit": "px"
      },
      "$description": "Controls: buttons, fields."
    },
    "lg": {
      "$value": {
        "value": 16,
        "unit": "px"
      },
      "$description": "Containers: cards, dialogs."
    },
    "xl": {
      "$value": {
        "value": 24,
        "unit": "px"
      },
      "$description": "Surfaces that float free of the screen edges: sheets, floating bars."
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      },
      "$description": "Pills and circles."
    }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "thin": {
        "$value": {
          "value": 1,
          "unit": "px"
        }
      },
      "thick": {
        "$value": {
          "value": 2,
          "unit": "px"
        },
        "$description": "Selected and invalid states that must not rely on color alone."
      }
    }
  },
  "focus": {
    "$type": "dimension",
    "width": {
      "$value": {
        "value": 2,
        "unit": "px"
      },
      "$description": "Focus ring thickness. WCAG 2.2 asks for an indicator at least 2px thick."
    },
    "offset": {
      "$value": {
        "value": 2,
        "unit": "px"
      },
      "$description": "Gap between a control and its focus ring, so the ring reads against the control's own fill."
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Pretendard Variable",
          "Pretendard",
          "-apple-system",
          "BlinkMacSystemFont",
          "system-ui",
          "Roboto",
          "Helvetica Neue",
          "Segoe UI",
          "Apple SD Gothic Neo",
          "Noto Sans KR",
          "Malgun Gothic",
          "sans-serif"
        ],
        "$description": "Pretendard covers Hangul, Latin and Kana with matching metrics. Where it is not loaded, Latin text falls to the system's own font and Hangul to the system's Korean font, in that order."
      }
    },
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": {
          "value": 12,
          "unit": "px"
        },
        "$description": "The smallest size Hangul stays legible at."
      },
      "sm": {
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 16,
          "unit": "px"
        },
        "$description": "Body text. Also the size below which iOS zooms the page when a field is focused."
      },
      "lg": {
        "$value": {
          "value": 18,
          "unit": "px"
        }
      },
      "xl": {
        "$value": {
          "value": 22,
          "unit": "px"
        }
      },
      "2xl": {
        "$value": {
          "value": 28,
          "unit": "px"
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500,
        "$description": "Labels on controls: heavier than body text without shouting."
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.25,
        "$description": "Large type and single-line labels."
      },
      "snug": {
        "$value": 1.4,
        "$description": "Headings and short text that may wrap."
      },
      "normal": {
        "$value": 1.5,
        "$description": "Body text. Hangul needs more leading than Latin at the same size."
      }
    }
  },
  "typography": {
    "$type": "typography",
    "$description": "Text styles by role. Screens pick a role, never a raw size.",
    "display": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.2xl}",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "{font.line-height.tight}",
        "letterSpacing": {
          "value": -0.3,
          "unit": "px"
        }
      },
      "$description": "One per screen at most: the name of the place."
    },
    "title": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.xl}",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "{font.line-height.tight}",
        "letterSpacing": {
          "value": -0.2,
          "unit": "px"
        }
      },
      "$description": "Section and dialog titles."
    },
    "heading": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.lg}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{font.line-height.snug}",
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "Card titles and group headings."
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.md}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.line-height.normal}",
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "Running text."
    },
    "body-strong": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.md}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{font.line-height.normal}",
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "Emphasis inside running text."
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.sm}",
        "fontWeight": "{font.weight.medium}",
        "lineHeight": "{font.line-height.snug}",
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "Button labels and field labels."
    },
    "detail": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.sm}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.line-height.normal}",
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "Descriptions, hints and secondary lines."
    },
    "footnote": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.xs}",
        "fontWeight": "{font.weight.medium}",
        "lineHeight": "{font.line-height.snug}",
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "Badges and timestamps."
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": {
          "value": 120,
          "unit": "ms"
        },
        "$description": "Feedback to a press or hover: must feel instant."
      },
      "normal": {
        "$value": {
          "value": 200,
          "unit": "ms"
        },
        "$description": "Something appearing or changing place."
      },
      "slow": {
        "$value": {
          "value": 320,
          "unit": "ms"
        },
        "$description": "Large surfaces: sheets, full panels."
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0,
          0,
          1
        ],
        "$description": "Moving between two places on screen."
      },
      "enter": {
        "$value": [
          0,
          0,
          0,
          1
        ],
        "$description": "Arriving: starts fast, settles."
      },
      "exit": {
        "$value": [
          0.3,
          0,
          1,
          1
        ],
        "$description": "Leaving: starts slow, gets out of the way."
      }
    },
    "press-scale": {
      "$type": "number",
      "$value": 0.97,
      "$description": "How far a button shrinks while it is pressed. Feedback that does not depend on color."
    },
    "spring": {
      "$type": "number",
      "$description": "Springs for things a finger moves or that settle into place. Stiffness as in a mass-spring system with mass 1; damping as a ratio, where 1 does not overshoot.",
      "default": {
        "stiffness": {
          "$value": 700
        },
        "damping": {
          "$value": 0.9
        }
      },
      "fast": {
        "stiffness": {
          "$value": 1400
        },
        "damping": {
          "$value": 0.9
        }
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "subtle": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 0.06,
          "hex": "#000000"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 1,
          "unit": "px"
        },
        "blur": {
          "value": 2,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "Cards and outlined controls: just enough to lift them off the page. Drawn together with a hairline border."
    },
    "raised": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 0.12,
          "hex": "#000000"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 4,
          "unit": "px"
        },
        "blur": {
          "value": 16,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "Menus and dialogs. Paired with background.raised, which carries the elevation in dark mode."
    },
    "overlay": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 0.35,
          "hex": "#000000"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 12,
          "unit": "px"
        },
        "blur": {
          "value": 32,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "Dialogs and sheets, which sit above everything else on the screen."
    }
  }
}
