{
  "placeholder": { "name": "acme", "title": "Acme" },
  "defaultTheme": "indigo",
  "exclude": [
    "cli",
    "apps/docs",
    "apps/web/wrangler.jsonc",
    "apps/web/public/_headers",
    "tools/deploy",
    "npm",
    "install.sh",
    "template.json",
    "README.md",
    "README.ko.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "CLAUDE.md",
    "skills",
    ".claude-plugin",
    "LICENSE",
    "docs/images",
    "flutter/ui/test/goldens",
    "docs/cli.md",
    "docs/library.md",
    "docs/web-library.md",
    ".github/workflows/release.yml",
    ".github/workflows/docs.yml",
    ".github/workflows/preview.yml",
    ".github/dependabot.yml",
    "Cargo.lock",
    "pnpm-lock.yaml",
    "mise.lock"
  ],
  "common": [
    "design",
    "tools/design-build",
    ".editorconfig",
    ".gitignore",
    ".gitattributes",
    "mise.toml",
    ".github/workflows/ci.yml",
    "docs/design-system.md"
  ],
  "shared": {
    "js-workspace": {
      "paths": [
        "package.json",
        "pnpm-workspace.yaml",
        ".oxfmtrc.jsonc",
        ".oxlintrc.jsonc",
        "tsconfig.base.json",
        "tools/check-tsrs.ts"
      ]
    },
    "js-tokens": {
      "paths": ["packages/tokens"]
    },
    "ui-core": {
      "paths": ["packages/ui-core"]
    },
    "rust-workspace": {
      "paths": ["Cargo.toml"]
    }
  },
  "targets": [
    {
      "id": "web-react",
      "package": "@acme/web",
      "default": true,
      "title": "Web",
      "stack": "React 19, Vite, Tailwind v4, Zag.js",
      "platforms": ["Web"],
      "input": "pointer",
      "paths": ["apps/web", "packages/ui"],
      "requires": ["js-workspace", "js-tokens", "ui-core"],
      "outputs": ["css", "tailwind", "typescript"],
      "format": "mise run fmt",
      "run": [
        {
          "command": "mise run //web:dev",
          "description": "Start the web app on http://localhost:5173"
        }
      ]
    },
    {
      "id": "web-solid",
      "package": "@acme/web-solid",
      "title": "Web",
      "stack": "SolidJS 2 (release candidate), Vite, Tailwind v4, Zag.js",
      "platforms": ["Web"],
      "input": "pointer",
      "paths": ["apps/web-solid", "packages/ui-solid"],
      "requires": ["js-workspace", "js-tokens", "ui-core"],
      "outputs": ["css", "tailwind", "typescript"],
      "format": "mise run fmt",
      "run": [
        {
          "command": "mise run //web-solid:dev",
          "description": "Start the Solid web app on http://localhost:5174"
        }
      ]
    },
    {
      "id": "web-vue",
      "package": "@acme/web-vue",
      "title": "Web",
      "stack": "Vue 3, Vite, Tailwind v4, Zag.js",
      "platforms": ["Web"],
      "input": "pointer",
      "paths": ["apps/web-vue", "packages/ui-vue"],
      "requires": ["js-workspace", "js-tokens", "ui-core"],
      "outputs": ["css", "tailwind", "typescript"],
      "format": "mise run fmt",
      "run": [
        {
          "command": "mise run //web-vue:dev",
          "description": "Start the Vue web app on http://localhost:5175"
        }
      ]
    },
    {
      "id": "web-svelte",
      "package": "@acme/web-svelte",
      "title": "Web",
      "stack": "Svelte 5, Vite, Tailwind v4, Zag.js",
      "platforms": ["Web"],
      "input": "pointer",
      "paths": ["apps/web-svelte", "packages/ui-svelte", ".pnpmfile.cjs"],
      "requires": ["js-workspace", "js-tokens", "ui-core"],
      "outputs": ["css", "tailwind", "typescript"],
      "format": "mise run fmt",
      "run": [
        {
          "command": "mise run //web-svelte:dev",
          "description": "Start the Svelte web app on http://localhost:5176"
        }
      ]
    },
    {
      "id": "desktop-electron",
      "title": "Desktop",
      "stack": "Electron, Electron Forge (wraps a web app)",
      "platforms": ["macOS", "Windows", "Linux"],
      "input": "pointer",
      "wraps": ["web-react", "web-solid", "web-vue", "web-svelte"],
      "paths": ["apps/desktop-electron"],
      "requires": ["js-workspace"],
      "format": "mise run fmt",
      "run": [
        { "command": "mise run //desktop-electron:dev", "description": "Open the wrapped web app" }
      ]
    },
    {
      "id": "desktop-tauri",
      "title": "Desktop",
      "stack": "Tauri 2 (wraps a web app)",
      "platforms": ["macOS", "Windows", "Linux"],
      "input": "pointer",
      "wraps": ["web-react", "web-solid", "web-vue", "web-svelte"],
      "paths": ["apps/desktop-tauri"],
      "requires": ["js-workspace", "rust-workspace"],
      "format": "mise run fmt",
      "run": [
        { "command": "mise run //desktop-tauri:dev", "description": "Open the wrapped web app" }
      ]
    },
    {
      "id": "desktop-gpui",
      "title": "Desktop",
      "stack": "Rust, GPUI, GPUI Component",
      "platforms": ["macOS"],
      "input": "pointer",
      "paths": ["apps/desktop", "crates/acme-ui", "crates/acme-tokens"],
      "requires": ["rust-workspace"],
      "outputs": ["rust"],
      "format": "mise run fmt",
      "run": [
        {
          "command": "mise run //desktop:dev",
          "description": "Start the desktop app"
        }
      ]
    },
    {
      "id": "mobile-react-native",
      "title": "Mobile",
      "stack": "React Native, Expo",
      "platforms": ["iOS", "Android"],
      "input": "touch",
      "paths": ["apps/mobile", "packages/ui-native", "tools/lint/react-native.ts"],
      "requires": ["js-workspace", "js-tokens"],
      "outputs": ["typescript"],
      "format": "mise run fmt",
      "run": [
        {
          "command": "mise run //mobile:ios",
          "description": "Start the mobile app in the iOS simulator"
        },
        {
          "command": "mise run //mobile:android",
          "description": "Start the mobile app in the Android emulator"
        }
      ]
    },
    {
      "id": "dart-flutter",
      "title": "Flutter",
      "stack": "Dart, Flutter widgets",
      "platforms": ["iOS", "Android"],
      "input": "touch",
      "paths": ["flutter"],
      "outputs": ["dart"],
      "format": "mise run fmt",
      "run": [
        { "command": "mise run //flutter:ios", "description": "Run the Flutter app on iOS" },
        { "command": "mise run //flutter:android", "description": "Run the Flutter app on Android" }
      ]
    },
    {
      "id": "kotlin-compose",
      "title": "Kotlin",
      "stack": "Kotlin, Compose Multiplatform",
      "platforms": ["Android", "iOS", "Desktop"],
      "input": "touch",
      "paths": ["kotlin"],
      "requires": [],
      "outputs": ["kotlin"],
      "run": [
        {
          "command": "mise run //kotlin:desktop",
          "description": "Start the Compose desktop app"
        },
        {
          "command": "mise run //kotlin:android",
          "description": "Run the Compose app on Android"
        }
      ]
    }
  ]
}
